# ============================================================================
# CampusZen - Plantilla de Configuración de Entorno
# ============================================================================
# Copiar este archivo a .env.local y completar con tus valores reales
# NO hacer commit de .env.local (está en .gitignore)

# ============================================================================
# CONFIGURACIÓN DE SUPABASE (REQUERIDO)
# ============================================================================
# Obtener desde: https://app.supabase.com → Settings → API

# URL del proyecto Supabase (público, usar en cliente)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Service Role Key (PRIVADO - solo servidor)
# Obtener de: https://app.supabase.com → Settings → API → Service Role Key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# SEGURIDAD - TOKENS Y SECRETOS
# ============================================================================
# Generar strings aleatorios con: openssl rand -base64 32

# Secret para firmar JWTs (mínimo 32 caracteres)
JWT_SECRET=your-random-secret-here-min-32-chars-long

# Secret para bootstrap/admin (mínimo 32 caracteres)
# Usado para crear el usuario admin inicial
ADMIN_BOOTSTRAP_SECRET=your-bootstrap-secret-here-min-32-chars-long

# ============================================================================
# ALMACENAMIENTO DE BLOBS (OPCIONAL)
# ============================================================================
# Token para acceso a Vercel Blob (si usas almacenamiento de archivos)
BLOB_READ_WRITE_TOKEN=

# ============================================================================
# CONFIGURACIÓN DE LA APP (PÚBLICO)
# ============================================================================
NEXT_PUBLIC_APP_NAME=CampusZen
NEXT_PUBLIC_APP_VERSION=1.0.0

# ============================================================================
# INSTRUCCIONES DE SETUP
# ============================================================================
# 1. Rellena los valores REQUERIDOS arriba
# 2. Ejecuta: npm run verify-supabase
# 3. Ejecuta: npm run dev
# 4. Accede a http://localhost:3000
# 5. Ve a /admin/db-setup para bootstrap de base de datos
#
# Ver SETUP_SUPABASE.md para instrucciones completas

